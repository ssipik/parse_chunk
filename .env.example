# For running the CLI from a host venv (docker compose maps Postgres to
# localhost:5433). Inside compose, RAG_PG_DSN is set on the service instead.
RAG_PG_DSN=postgresql+psycopg://rag:rag@localhost:5433/rag_ingestion
#RAG_HTTP_TIMEOUT=30
#RAG_HTTP_USER_AGENT=rag-pipeline-ingest/0.1

# Confluence Cloud basic auth, needed only by confluence sources. The token is a
# personal API token from id.atlassian.com. Never put it in sources.yaml.
#RAG_CONFLUENCE_EMAIL=you@example.com
#RAG_CONFLUENCE_API_TOKEN=
